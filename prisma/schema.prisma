generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CLEANER
  OWNER
}

enum PropertyType {
  STUDIO
  APT_1_1
  APT_2_1
  APT_3_1
  VILLA
  VILLA_POOL
  HOUSE
}

enum BookingKind {
  RESERVATION
  OWNER_STAY
  MAINTENANCE
  EXTERNAL_BLOCK
}

enum BookingSource {
  DIRECT
  BOOKING
  AIRBNB
  PHONE
  OWNER
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  CASH
  BANK
  CARD
  PLATFORM
  OTHER
}

enum TaskType {
  CLEANING
  MAINTENANCE
  INSPECTION
  CHECKIN
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Channel {
  BOOKING
  AIRBNB
  OTHER
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String
  role           Role
  active         Boolean  @default(true)
  // Management commission (%) applied to owners' revenue
  commissionRate Decimal  @default(20) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedProperties Property[] @relation("PropertyOwner")
  tasks           Task[]     @relation("TaskAssignee")
  cleaningFor     Property[] @relation("PropertyCleaner")
  ownerRequests   Booking[]  @relation("BookingRequestedBy")
}

model Property {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  type           PropertyType
  summarySq      String       @default("")
  summaryEn      String       @default("")
  descriptionSq  String       @default("") @db.Text
  descriptionEn  String       @default("") @db.Text
  address        String       @default("")
  city           String       @default("")
  lat            Float?
  lng            Float?
  maxGuests      Int          @default(2)
  bedrooms       Int          @default(1)
  beds           Int          @default(1)
  bathrooms      Int          @default(1)
  areaM2         Int?
  distanceToSeaM Int?
  amenities      String[]     @default([])
  basePrice      Decimal      @db.Decimal(10, 2)
  weekendPrice   Decimal?     @db.Decimal(10, 2)
  cleaningFee    Decimal      @default(0) @db.Decimal(10, 2)
  minNights      Int          @default(1)
  checkInTime    String       @default("15:00")
  checkOutTime   String       @default("11:00")
  // Internal info shared with guests/staff
  wifiName       String?
  wifiPassword   String?
  doorCode       String?
  internalNotes  String?      @db.Text
  published      Boolean      @default(true)
  active         Boolean      @default(true)
  icalToken      String       @unique @default(cuid())
  ownerId        String?
  owner          User?        @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Cleaning tasks are auto-assigned to this staff member
  cleanerId      String?
  cleaner        User?        @relation("PropertyCleaner", fields: [cleanerId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  images    PropertyImage[]
  rates     SeasonalRate[]
  bookings  Booking[]
  tasks     Task[]
  expenses  Expense[]
  icalFeeds IcalFeed[]
  inquiries Inquiry[]
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  position   Int      @default(0)
}

model SeasonalRate {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date // inclusive
  pricePerNight Decimal  @db.Decimal(10, 2)
  weekendPrice  Decimal? @db.Decimal(10, 2)
  minNights     Int?
}

model Guest {
  id             String    @id @default(cuid())
  name           String
  email          String?
  phone          String?
  nationality    String?
  documentType   String?
  documentNumber String?
  birthDate      DateTime? @db.Date
  notes          String?   @db.Text
  vip            Boolean   @default(false)
  blacklisted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  bookings       Booking[]
}

model Booking {
  id                 String        @id @default(cuid())
  code               String        @unique
  propertyId         String
  property           Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind               BookingKind   @default(RESERVATION)
  source             BookingSource @default(DIRECT)
  status             BookingStatus @default(CONFIRMED)
  checkIn            DateTime      @db.Date
  checkOut           DateTime      @db.Date
  adults             Int           @default(2)
  children           Int           @default(0)
  guestId            String?
  guest              Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  // Money
  accommodationTotal Decimal       @default(0) @db.Decimal(10, 2)
  cleaningFee        Decimal       @default(0) @db.Decimal(10, 2)
  platformCommission Decimal       @default(0) @db.Decimal(10, 2)
  notes              String?       @db.Text
  // iCal import
  externalUid        String?
  icalFeedId         String?
  icalFeed           IcalFeed?     @relation(fields: [icalFeedId], references: [id], onDelete: Cascade)
  // Owner stay requests
  requestedById      String?
  requestedBy        User?         @relation("BookingRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments Payment[]
  tasks    Task[]

  @@unique([icalFeedId, externalUid])
  @@index([propertyId, checkIn, checkOut])
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  note      String?
}

model Task {
  id          String     @id @default(cuid())
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type        TaskType   @default(CLEANING)
  title       String
  description String?    @db.Text
  dueDate     DateTime
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status      TaskStatus @default(TODO)
  // [{ label: string, done: boolean }]
  checklist   Json       @default("[]")
  issueReport String?    @db.Text
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([dueDate])
}

model Expense {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category      String
  amount        Decimal  @db.Decimal(10, 2)
  date          DateTime @db.Date
  description   String?
  chargeToOwner Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model IcalFeed {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channel    Channel
  url        String
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  bookings   Booking[]
}

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  checkIn    DateTime      @db.Date
  checkOut   DateTime      @db.Date
  guests     Int
  message    String?       @db.Text
  quotedTotal Decimal?     @db.Decimal(10, 2)
  locale     String        @default("sq")
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
}

model OwnerLead {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  propertyType PropertyType?
  location     String?
  message      String?       @db.Text
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
}

model MessageTemplate {
  id     String @id @default(cuid())
  key    String @unique
  name   String
  bodySq String @db.Text
  bodyEn String @db.Text
}

model Setting {
  key   String @id
  value String @db.Text
}
